{
  "name": "hoterstellar-server",
  "version": "1.0.0",
  "private": true,
  "description": "Hoterstellar Hotel & Restaurant Management Backend API",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "dev:worker": "nodemon worker.js",
    "worker": "node worker.js",
    "start": "node server.js",
    "seed": "node src/scripts/seed.js",
    "test:email": "node src/scripts/test-brevo-email.js",
    "lint": "eslint . --config eslint.config.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"server.js\" \"worker.js\""
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@imagekit/nodejs": "^7.11.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@upstash/redis": "^1.38.3",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "chalk": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.4",
    "multer": "^2.3.0",
    "pino": "^10.3.1",
    "rate-limit-redis": "^6.0.1",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  }
}
